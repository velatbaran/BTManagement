@model PurchaseForm

@{
    ViewData["Title"] = "Satın Alma Şekli Güncelle";
}

<link href="~/css/custom-theme.css" rel="stylesheet" />

<div class="row justify-content-start mb-5">
    <div class="col-lg-8">
        <div class="form-card">
            <div class="form-card-header">
                <h5>
                    <i class="fa-solid fa-pen-to-square"></i> Satın Alma Şekli Güncelle
                </h5>
            </div>

            <div class="form-card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="Created" />

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Satın Alma Şekli Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Satın alma şekli adını giriniz..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-2">
                        <button type="submit" class="btn-submit" title="Güncelle">
                            <i class="fa-solid fa-floppy-disk"></i> Güncelle
                        </button>
                        <a href="/satinalimsekilleri" class="btn-cancel" title="İptal">
                            <i class="fa-solid fa-xmark"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}