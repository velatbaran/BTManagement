@model Products

@{
    ViewData["Title"] = "Ürün Güncelle";
}

<!-- FontAwesome & Google Fonts -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link href="~/css/product-theme.css" rel="stylesheet" />

<div class="container-fluid px-0">
    <!-- Header Kartı -->
    <div class="card app-card mb-3">
        <div class="card-body app-card-header d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-3" style="background: #eef2ff; color: #4B49AC;">
                    <i class="fa-solid fa-pen-to-square fa-lg"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: #0f172a;">Ürün Güncelle</h5>
                    <p class="text-muted small mb-0">Mevcut envanter kaydının detaylarını düzenleyin.</p>
                </div>
            </div>
            <a href="/urunler" class="btn btn-modern-ghost d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>

    <!-- Form Kartı -->
    <div class="card app-card">
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Hidden Fields -->
                <input type="hidden" asp-for="Id" />
                @* <input type="hidden" asp-for="CreatedDate" /> *@
                @* <input type="hidden" asp-for="Created" /> *@

                <div class="row g-4">
                    <!-- Sol Kolon: Temel ve Ağ Bilgileri -->
                    <div class="col-lg-6">
                        <div class="section-title d-flex align-items-center gap-2">
                            <i class="fa-solid fa-microchip"></i> Donanım ve Ağ Bilgileri
                        </div>

                        <div class="mb-3">
                            <label asp-for="Brand" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-copyright"></i></span>
                                <input asp-for="Brand" class="form-control" placeholder="Örn: Dell, HP, Lenovo" />
                            </div>
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-cube"></i></span>
                                <input asp-for="Model" class="form-control" placeholder="Örn: Latitude 5520" />
                            </div>
                            <span asp-validation-for="Model" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SerialNo" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-hashtag"></i></span>
                                <input asp-for="SerialNo" class="form-control" placeholder="Seri numarasını giriniz" />
                            </div>
                            <span asp-validation-for="SerialNo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NetworkAddress" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-network-wired"></i></span>
                                <input asp-for="NetworkAddress" class="form-control" placeholder="Örn: 192.168.1.100" />
                            </div>
                            <span asp-validation-for="NetworkAddress" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NetworkName" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-globe"></i></span>
                                <input asp-for="NetworkName" class="form-control" placeholder="Örn: PC-AHMET" />
                            </div>
                            <span asp-validation-for="NetworkName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HardwareName" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-desktop"></i></span>
                                <input asp-for="HardwareName" class="form-control" placeholder="Donanım adını giriniz" />
                            </div>
                            <span asp-validation-for="HardwareName" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Sağ Kolon: Sorumlu, Durum ve Kategori Bilgileri -->
                    <div class="col-lg-6">
                        <div class="section-title d-flex align-items-center gap-2">
                            <i class="fa-solid fa-sliders"></i> Sınıflandırma ve Detaylar
                        </div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                                <input asp-for="Username" class="form-control" placeholder="Kullanıcı adı veya zimmetli kişi" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="State" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-circle-dot"></i></span>
                                <select asp-for="State" class="form-select">
                                    <option value="Faal">Faal</option>
                                    <option value="Arızalı">Arızalı</option>
                                    <option value="Kayıttan Düşürülmüş">Kayıttan Düşürülmüş</option>
                                </select>
                            </div>
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-layer-group"></i></span>
                                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                        @* <option value="">-- Seçiniz --</option> *@
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DepartmentId" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-building"></i></span>
                                    <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId">
                                        @* <option value="">-- Seçiniz --</option> *@
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Feature" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-list-check"></i></span>
                                <input asp-for="Feature" class="form-control" placeholder="Örn: 16GB RAM, 512GB SSD" />
                            </div>
                            <span asp-validation-for="Feature" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ek notlar veya açıklamalar..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Alt Aksiyon Butonları -->
                <div class="pt-3 mt-4 border-top d-flex align-items-center justify-content-end gap-2">
                    <a href="/urunler" class="btn btn-modern-ghost">
                        <i class="fa-solid fa-ban me-1"></i> İptal
                    </a>
                    <button type="submit" class="btn btn-modern-primary d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-pen-to-square"></i> Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}