            $('#myTable tbody').on(
                'click',
                'td.details-control .detail-toggle',
                function (e) {

                    e.stopPropagation();

                    var tr = $(this).closest('tr');
                    var row = table.row(tr);

                    if (row.child.isShown()) {
                        row.child.hide();
                        tr.removeClass('shown');
                    }
                    else {
                        table.rows('.shown').every(function () {
                            this.child.hide();
                            $(this.node()).removeClass('shown');
                        });

                        row.child(format(row.data())).show();
                        tr.addClass('shown');
                    }
                }
            );

            $('#myTable tbody').on(
                'dblclick',
                'tr',
                function (e) {

                    if (
                        $(e.target).closest(
                            '.btn-action, .btn-edit, .btn-delete, .detail-toggle, input, button, a'
                        ).length
                    ) {
                        return;
                    }

                    if ($(this).hasClass('child')) {
                        return;
                    }

                    var tr = $(this);
                    var row = table.row(tr);

                    if (!row || !row.data()) {
                        return;
                    }

                    var data = row.data();

                    $('#detailModalTitle').text(
                        (data.brand || '-') + ' ' + (data.model || '')
                    );

                    $('#detailModalSubtitle').text('Envanter kayıt detayları');

                    $('#detailProductName').text(
                        (data.brand || '-') + ' ' + (data.model || '-')
                    );

                    $('#detailProductSerial').text(
                        'Seri No: ' + (data.serialNo || '-')
                    );

                    $('#detailProductStatus').html(
                        formatStatus(data.state)
                    );

                    setDetailValue('#detailBrand', data.brand);
                    setDetailValue('#detailModel', data.model);
                    setDetailValue('#detailSerialNo', data.serialNo);
                    setDetailValue('#detailUsername', data.username);
                    setDetailValue('#detailCategory', data.categoryName);
                    setDetailValue('#detailDepartment', data.departmentName);

                    setDetailValue('#detailNetworkAddress', data.networkAddress);
                    setDetailValue('#detailNetworkName', data.networkName);
                    setDetailValue('#detailHardwareName', data.hardwareName);
                    setDetailValue('#detailFeature', data.feature);

                    setDetailValue('#detailDescription', data.description);

                    setDetailValue('#detailCreated', data.created);
                    setDetailValue('#detailCreatedDate', data.createdDate);

                    $('#detailEditButton').attr(
                        'href',
                        '/urunguncelle/' + data.id
                    );

                    $('#detailDeleteButton')
                        .attr('data-file-id', data.id)
                        .attr('data-file-name', data.brand || 'Kayıt');

                    $('#productDetailModal').modal('show');
                }
            );

            function setDetailValue(selector, value) {
                var text = value;

                if (
                    text === null ||
                    text === undefined ||
                    text === ''
                ) {
                    text = '-';
                }

                $(selector).text(text);
            }

            $('#detailDeleteButton').on('click', function () {

                var id = $(this).attr('data-file-id');
                var name = $(this).attr('data-file-name');

                $('#productDetailModal').modal('hide');

                $('#fileId').val(id);
                $('#fileName').text(name);

                setTimeout(function () {
                    $('#deleteModal').modal('show');
                }, 250);
            });

            $('#myTable tbody').on(
                'click',
                '.btn-delete, .btn-delete-detail',
                function () {

                    $('#fileId').val(
                        $(this).data('file-id')
                    );

                    $('#fileName').text(
                        $(this).data('file-name')
                    );

                    $('#deleteModal').modal('show');
                }
            );

        });
    </script>
}

