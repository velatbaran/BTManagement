@model IEnumerable<Products>

@{
    ViewData["Title"] = "Ürün Listesi";
}
<link href="~/datatable/buttons.datatables.css" rel="stylesheet" />
<link href="~/datatable/responsive.datatables.min.css" rel="stylesheet" />
<link href="~/datatable/datatables.min.css" rel="stylesheet" />
<p>
    <a asp-action="Create" class="btn btn-primary" title="Yeni Ekle">
        <i class="fa-solid fa-plus"></i> Yeni Ekle
    </a>
</p>

<style>
    .table {
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 14px;
        color: #333;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table th {
            background: #f0f2f5;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            padding: 10px;
            border-bottom: 2px solid #dcdfe3;
        }

        .table td {
            font-size: 12px;
            padding: 8px 10px;
            vertical-align: middle;
        }

        /* Modern input stil */
        .table input[type="text"] {
            width: 95%;
            padding: 6px 10px;
            border: 1px solid #c4c7cc;
            border-radius: 6px;
            font-size: 12px;
            background: #fff;
            transition: all .25s ease;
        }

            /* Hover input */
            .table input[type="text"]:hover {
                border-color: #9ba0a8;
                background: #fafafa;
            }

            /* Focus efekti */
            .table input[type="text"]:focus {
                outline: none;
                border-color: #4a90e2;
                box-shadow: 0 0 4px rgba(74, 144, 226, 0.4);
                background: #fff;
            }

        /* Satır hover */
        .table tbody tr:hover {
            background-color: #f7faff;
        }

    /* Butonlara küçük estetik dokunuş */
    .btn-rounded {
        border-radius: 6px !important;
    }

    /* Tablonun üst kenarına hafif gölge */
    #myTable {
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-radius: 8px;
        overflow: hidden;
    }
</style>

<table class="table table-bordered table-striped" id="myTable">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Brand)</th>
            <th>@Html.DisplayNameFor(m => m.Model)</th>
            <th>@Html.DisplayNameFor(m => m.SerialNo)</th>
            <th>@Html.DisplayNameFor(m => m.Username)</th>
            <th>@Html.DisplayNameFor(m => m.CategoryId)</th>
            <th>@Html.DisplayNameFor(m => m.DepartmentId)</th>
            <th>@Html.DisplayNameFor(m => m.State)</th>
            <th>@Html.DisplayNameFor(m => m.Description)</th>
            <th>@Html.DisplayNameFor(m => m.NetworkAddress)</th>
            <th>@Html.DisplayNameFor(m => m.NetworkName)</th>
            <th>@Html.DisplayNameFor(m => m.HardwareName)</th>
            <th>@Html.DisplayNameFor(m => m.Feature)</th>
            <th>@Html.DisplayNameFor(m => m.Created)</th>
            <th>@Html.DisplayNameFor(m => m.CreatedDate)</th>
            <th>İşlemler</th>
        </tr>
        <tr>
            <th><input type="text" placeholder="Ara Marka" /></th>
            <th><input type="text" placeholder="Ara Model" /></th>
            <th><input type="text" placeholder="Ara Seri No" /></th>
            <th><input type="text" placeholder="Ara Kullanıcı" /></th>
            <th><input type="text" placeholder="Ara Kategori" /></th>
            <th><input type="text" placeholder="Ara Departman" /></th>
            <th><input type="text" placeholder="Ara Durum" /></th>
            <th><input type="text" placeholder="Ara Açıklama" /></th>
            <th><input type="text" placeholder="Ara Ağ Adresi" /></th>
            <th><input type="text" placeholder="Ara Ağ Adı" /></th>
            <th><input type="text" placeholder="Ara Donanım Adı" /></th>
            <th><input type="text" placeholder="Ara Özellik" /></th>
            <th><input type="text" placeholder="Ara Oluşturan" /></th>
            <th><input type="text" placeholder="Ara Tarih" /></th>
            <th></th> <!-- İşlemler sütunu filtre yok -->
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m => item.Brand)</td>
                <td>@Html.DisplayFor(m => item.Model)</td>
                <td>@Html.DisplayFor(m => item.SerialNo)</td>
                <td>@Html.DisplayFor(m => item.Username)</td>
                <td>@Html.DisplayFor(m => item.Category.Name)</td>
                <td>@Html.DisplayFor(m => item.Department.Name)</td>
                <td>@Html.DisplayFor(m => item.State)</td>
                <td>@Html.DisplayFor(m => item.Description)</td>
                <td>@Html.DisplayFor(m => item.NetworkAddress)</td>
                <td>@Html.DisplayFor(m => item.NetworkName)</td>
                <td>@Html.DisplayFor(m => item.HardwareName)</td>
                <td>@Html.DisplayFor(m => item.Feature)</td>
                <td>@Html.DisplayFor(m => item.Created)</td>
                <td>@Html.DisplayFor(m => item.CreatedDate)</td>
                <td>
                    <a class="btn btn-warning btn-sm btn-rounded" asp-action="Edit" asp-route-id="@item.Id" title="Güncelle">
                        <i class="fa-solid fa-pen-to-square"></i> Güncelle
                    </a>
                    <button type="button" class="btn btn-danger btn-sm btn-rounded"
                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-file-id="@item.Id" data-file-name="@item.Brand" title="Sil">
                        <i class="fa-solid fa-trash"></i> Sil
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Silme Onayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <strong id="fileName"></strong> silmek istediğine emin misin?
                    <input type="hidden" name="id" id="fileId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm btn-rounded" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark" title="İptal"></i> İptal
                    </button>
                    <button type="submit" class="btn btn-outline-danger btn-sm btn-rounded" title="Sil">
                        <i class="fa-solid fa-trash"></i> Sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/datatable/datatables.min.js"></script>
    <script src="~/datatable/datatables.responsive.min.js"></script>
    <script src="~/datatable/datatables.buttons.min.js"></script>
    <script src="~/datatable/buttons.html5.min.js"></script>
    <script src="~/datatable/buttons.print.min.js"></script>
    <script src="~/datatable/jszip.min.js"></script>
    <script src="~/datatable/pdfmake.min.js"></script>
    <script src="~/datatable/vfs_fonts.js"></script>
    <script>
        $(document).ready(function () {

            var table = $('#myTable').DataTable({
            stateSave: true,
            stateDuration: -1,
            dom: 'Brtip',
            buttons: ['copy','excel','csv','pdf','print'],
            responsive: { details: { type: 'column' } },
            columnDefs: [
                { className: 'control', orderable: false, targets: 0 },
                { orderable: false, targets: -1 }
            ],
            order: [[1, 'asc']],
            language: { url: '/datatable/tr.json' }
        });

             function normalizeTr(text) {
            if (!text) return "";

            return text.toString()
                .toLowerCase()
                .replace(/ı/g, "i")
                .replace(/İ/g, "i")
                .replace(/i̇/g, "i")
                .replace(/ğ/g, "g")
                .replace(/ü/g, "u")
                .replace(/ş/g, "s")
                .replace(/ö/g, "o")
                .replace(/ç/g, "c");
        }


            // Modal tetikleme
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                $('#fileId').val(button.data('file-id'));
                $('#fileName').text(button.data('file-name'));
            });

        let filters = ["", "", "", "", ""];
                                // filtre değişince kaydet
        $('#myTable thead tr:eq(1) th input').on('keyup', function () {

            $('#myTable thead tr:eq(1) th input').each(function (i) {
                filters[i] = $(this).val();
            });

            localStorage.setItem("guideFilters", JSON.stringify(filters));

            table.draw(false);
        });
                        // 🔹 Türkçe uyumlu custom search
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

                var brandInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(0) input').val());
                var modelInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(1) input').val());
                var serialNoInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(2) input').val());
                var usernameInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(3) input').val());
                var categoryInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(4) input').val());
                var departmentInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(5) input').val());
                var stateInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(6) input').val());
                var descriptionInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(7) input').val());
                var networkAddressInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(8) input').val());
                var networkNameInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(9) input').val());
                var hardwareNameInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(10) input').val());
                var featureInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(11) input').val());
                var createdInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(12) input').val());
                var createdDateInput = normalizeTr($('#myTable thead tr:eq(1) th:eq(13) input').val());

                var rowBrand = normalizeTr(data[0]);   // Personel
                var rowModel = normalizeTr(data[1]);  // Gidilen Yer
                var rowSerialNo = normalizeTr(data[2]);  // Varış Tarihi
                var rowUsername = normalizeTr(data[3]);  // Aktif Ayrılış Tarihi
                var rowCategory = normalizeTr(data[4]);  // Toplam Gün
                var rowDepartment = normalizeTr(data[5]); // Açıklama
                var rowState = normalizeTr(data[6]); // Tamamlandı  Mı?
                var rowDescription = normalizeTr(data[7]); // Tamamlandı  Mı?
                var rowNetworkAddress = normalizeTr(data[8]); // Tamamlandı  Mı?
                var rowNetworkName = normalizeTr(data[9]); // Tamamlandı  Mı?
                var rowHardwareName = normalizeTr(data[10]); // Tamamlandı  Mı?
                var rowFeature = normalizeTr(data[11]); // Tamamlandı  Mı?
                var rowCreated = normalizeTr(data[12]); // Tamamlandı  Mı?
                var rowCreatedDate = normalizeTr(data[13]); // Tamamlandı  Mı?

                if (brandInput && !rowBrand.includes(brandInput)) return false;
                if (modelInput && !rowModel.includes(modelInput)) return false;
                if (serialNoInput && !rowSerialNo.includes(serialNoInput)) return false;
                if (usernameInput && !rowUsername.includes(usernameInput)) return false;
                if (categoryInput && !rowCategory.includes(categoryInput)) return false;
                if (departmentInput && !rowDepartment.includes(departmentInput)) return false;
                if (stateInput && !rowState.includes(stateInput)) return false;
                if (descriptionInput && !rowDescription.includes(descriptionInput)) return false;
                if (networkAddressInput && !rowNetworkAddress.includes(networkAddressInput)) return false;
                if (networkNameInput && !rowNetworkName.includes(networkNameInput)) return false;
                if (hardwareNameInput && !rowHardwareName.includes(hardwareNameInput)) return false;
                if (featureInput && !rowFeature.includes(featureInput)) return false;
                if (createdInput && !rowCreated.includes(createdInput)) return false;
                if (createdDateInput && !rowCreatedDate.includes(createdDateInput)) return false;

                return true;
            });

                        $('#myTable thead input').on('click focus', function (e) {
            e.stopPropagation();
        });

                var savedFilters = JSON.parse(localStorage.getItem("productFilters"));

        if (savedFilters) {
            $('#myTable thead tr:eq(1) th input').each(function (i) {
                $(this).val(savedFilters[i]);
            });
        }

        });
    </script>
}
