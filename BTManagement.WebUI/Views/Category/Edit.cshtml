@model Categories

@{
    ViewData["Title"] = "Kategori Güncelle";
}

<style>
    .form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .form-card-header {
        background-color: #4B49AC;
        color: #ffffff;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .form-card-header h5 {
            margin: 0;
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 0.02em;
        }

    .form-card-body {
        padding: 24px;
    }

    .custom-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 8px;
    }

    .custom-input {
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.875rem;
        background-color: #f8fafc;
        transition: all 0.2s ease;
    }

        .custom-input:focus {
            outline: none;
            border-color: #4B49AC;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(75, 73, 172, 0.15);
        }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 24px;
        padding-top: 16px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-custom-update {
        background-color: #d97706;
        color: #ffffff;
        border: none;
        padding: 9px 20px;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

        .btn-custom-update:hover {
            background-color: #b45309;
            color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(217, 119, 6, 0.25);
        }

    .btn-custom-cancel {
        background-color: #f1f5f9;
        color: #64748b;
        border: 1px solid #cbd5e1;
        padding: 9px 20px;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-custom-cancel:hover {
            background-color: #e2e8f0;
            color: #334155;
        }
</style>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="form-card">
            <div class="form-card-header">
                <i class="fa-solid fa-pen-to-square fs-5"></i>
                <h5>Kategori Güncelle</h5>
            </div>
            <div class="form-card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="Created" />

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="custom-label">Kategori Adı</label>
                        <input asp-for="Name" class="form-control custom-input" placeholder="Kategori adını giriniz..." />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-custom-update" title="Güncelle">
                            <i class="fa-solid fa-pen-to-square"></i> Güncelle
                        </button>
                        <a href="/kategoriler" class="btn-custom-cancel" title="İptal">
                            <i class="fa-solid fa-ban"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}