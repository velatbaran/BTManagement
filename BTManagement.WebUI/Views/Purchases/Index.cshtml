@section Scripts {
     <script src="~/datatable/datatables.min.js"></script> <script src="~/datatable/datatables.responsive.min.js"></script> <script src="~/datatable/datatables.buttons.min.js"></script> <script src="~/datatable/buttons.html5.min.js"></script> <script src="~/datatable/buttons.print.min.js"></script> <script src="~/datatable/jszip.min.js"></script> <script src="~/datatable/pdfmake.min.js"></script> <script src="~/datatable/vfs_fonts.js"></script>

    ```
    <script>
        $(document).ready(function () {
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                $('#fileId').val(button.data('file-id'));
                $('#fileName').text(button.data('file-name'));
            });

            var totalAll = @Html.Raw(Json.Serialize(ViewBag.TotalAll ?? 0));

            $('#allTotalBtn').text(
                totalAll.toLocaleString('tr-TR', {
                    style: 'currency',
                    currency: 'TRY'
                })
            );

            function saveStateToSession(filters, order) {
                try {
                    var state = {
                        filters: filters || {},
                        order: order || []
                    };

                    sessionStorage.setItem(
                        'purchaseTableState',
                        JSON.stringify(state)
                    );

                    sessionStorage.setItem(
                        'purchaseReturnPage',
                        window.location.pathname
                    );
                } catch (e) {
                    console.error('State kaydedilirken hata:', e);
                }
            }

            function getStateFromSession() {
                try {
                    var state = sessionStorage.getItem('purchaseTableState');
                    var returnFrom = sessionStorage.getItem('purchaseReturnPage');

                    if (state && returnFrom === window.location.pathname) {
                        return JSON.parse(state);
                    }

                    return null;
                } catch (e) {
                    console.error('State okunurken hata:', e);
                    return null;
                }
            }

            var savedState = getStateFromSession();
            var savedFilters = savedState ? savedState.filters : null;
            var savedOrder = savedState ? savedState.order : null;

            var table = $('#myTable').DataTable({
                dom: '<"d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom"B><"d-flex flex-wrap justify-content-between align-items-center p-3"l>rt<"d-flex flex-wrap justify-content-between align-items-center p-3"ip>',
                buttons: [
                    {
                        extend: 'copy',
                        className: 'btn btn-outline-secondary btn-sm'
                    },
                    {
                        extend: 'excel',
                        className: 'btn btn-outline-success btn-sm'
                    },
                    {
                        extend: 'pdf',
                        className: 'btn btn-outline-danger btn-sm'
                    },
                    {
                        extend: 'print',
                        className: 'btn btn-outline-dark btn-sm'
                    }
                ],
                responsive: true,
                columnDefs: [
                    {
                        orderable: false,
                        targets: [10]
                    }
                ],
                order: savedOrder || [[0, 'desc']],
                pageLength: 25,
                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, 'Tümü']
                ],
                language: {
                    url: '/datatable/tr.json'
                },
                stateSave: false
            });

            table.on('init.dt', function () {
                if (savedFilters && Object.keys(savedFilters).length > 0) {
                    for (var col in savedFilters) {
                        var value = savedFilters[col];
                        var input = $('.filter-input[data-column="' + col + '"]');

                        if (input.length) {
                            input.val(value);
                        }
                    }

                    for (var col in savedFilters) {
                        table.column(parseInt(col)).search(savedFilters[col]);
                    }

                    table.draw();
                    updateTotal();
                }
            });

            $('#myTable thead tr:eq(1) th input').on('mousedown click', function (e) {
                e.stopPropagation();
            });

            $('#myTable thead tr:eq(1) th input').on('keyup change', function () {
                var colIndex = $(this).closest('th').index();
                var value = this.value;
                var currentOrder = table.order();

                table.column(colIndex).search(value).draw();

                if (currentOrder && currentOrder.length > 0) {
                    table.order(currentOrder).draw(false);
                }

                updateTotal();
            });

            $('#clearFiltersBtn').on('click', function () {
                $('.filter-input').each(function () {
                    $(this).val('');
                });

                table.columns().every(function () {
                    this.search('');
                });

                var currentOrder = table.order();

                table.draw();

                if (currentOrder && currentOrder.length > 0) {
                    table.order(currentOrder).draw(false);
                }

                updateTotal();

                sessionStorage.removeItem('purchaseTableState');
                sessionStorage.removeItem('purchaseReturnPage');
            });

            function saveCurrentState() {
                var filters = {};

                $('.filter-input').each(function () {
                    var val = $(this).val();

                    if (val && val.trim() !== '') {
                        filters[$(this).data('column')] = val.trim();
                    }
                });

                saveStateToSession(filters, table.order());
            }

            $(document).on(
                'click',
                '.btn-edit, .btn-delete, #btnCreate, .btn-delete-detail',
                function () {
                    saveCurrentState();
                }
            );

            $(window).on('beforeunload', function () {
                saveCurrentState();
            });

            function updateTotal() {
                var hasFilter = false;

                table.columns().every(function () {
                    if (this.search().length > 0) {
                        hasFilter = true;
                    }
                });

                if (!hasFilter) {
                    $('#allTotalBtn').text(
                        totalAll.toLocaleString('tr-TR', {
                            style: 'currency',
                            currency: 'TRY'
                        })
                    );

                    return;
                }

                var filteredTotal = table
                    .column(3, { search: 'applied' })
                    .nodes()
                    .toArray()
                    .reduce(function (total, node) {
                        return total + (parseFloat($(node).data('value')) || 0);
                    }, 0);

                $('#allTotalBtn').text(
                    filteredTotal.toLocaleString('tr-TR', {
                        style: 'currency',
                        currency: 'TRY'
                    })
                );
            }

            var toastEl = document.getElementById('copyToast');
            var toastMessage = document.getElementById('toastMessage');
            var toastIcon = document.getElementById('toastIcon');
            var toast = null;

            if (toastEl && typeof bootstrap !== 'undefined' && bootstrap.Toast) {
                toast = new bootstrap.Toast(toastEl, {
                    delay: 3000
                });
            }

            function showCopyNotification(success) {
                if (!toastEl || !toastMessage || !toastIcon) {
                    return;
                }

                if (success) {
                    toastMessage.textContent = 'Dosya yolu panoya kopyalandı!';
                    toastEl.className = 'toast align-items-center text-white bg-success border-0 shadow-lg';
                    toastIcon.className = 'fa-solid fa-check me-1';
                } else {
                    toastMessage.textContent = 'Kopyalama başarısız oldu!';
                    toastEl.className = 'toast align-items-center text-white bg-danger border-0 shadow-lg';
                    toastIcon.className = 'fa-solid fa-xmark me-1';
                }

                if (toast) {
                    toast.show();
                }
            }

            function copyTextToClipboard(text) {
                if (
                    text === null ||
                    text === undefined ||
                    String(text).trim() === ''
                ) {
                    return false;
                }

                var textArea = document.createElement('textarea');

                textArea.value = String(text);
                textArea.setAttribute('readonly', '');
                textArea.style.position = 'fixed';
                textArea.style.left = '0';
                textArea.style.top = '0';
                textArea.style.width = '1px';
                textArea.style.height = '1px';
                textArea.style.padding = '0';
                textArea.style.margin = '0';
                textArea.style.border = '0';
                textArea.style.outline = '0';
                textArea.style.boxShadow = 'none';
                textArea.style.background = 'transparent';
                textArea.style.opacity = '0';
                textArea.style.zIndex = '-1';

                document.body.appendChild(textArea);

                textArea.focus();
                textArea.select();

                var success = false;

                try {
                    success = document.execCommand('copy');
                } catch (error) {
                    success = false;
                }

                document.body.removeChild(textArea);

                return success;
            }

            $('#myTable').on('click', '.copy-path-btn', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var path = $(this).attr('data-path');

                if (!path || path.trim() === '') {
                    showCopyNotification(false);
                    return;
                }

                var success = copyTextToClipboard(path);

                showCopyNotification(success);
            });

            function showPurchaseDetail(rowData) {
                $('#detailFileNo').text(rowData.fileno || '-');
                $('#detailWorkingName').text(rowData.workingname || '-');

                $('#detailPrice').text(
                    (parseFloat(rowData.price) || 0).toLocaleString('tr-TR', {
                        style: 'currency',
                        currency: 'TRY'
                    })
                );

                $('#detailFirm').text(rowData.firm || '-');
                $('#detailPurchaseDate').text(rowData.purchasedate || '-');
                $('#detailPurchaseForm').text(rowData.purchaseform || '-');
                $('#detailPurchaseKind').text(rowData.purchasekind || '-');
                $('#detailPurchaseType').text(rowData.purchasetype || '-');
                $('#detailDescription').text(rowData.description || '-');

                var filePath = rowData.filepath || '-';

                $('#detailFilePathText').text(filePath);
                $('#detailCopyPathBtn').attr('data-path', filePath);

                $('#detailModalTitle').text(
                    rowData.fileno || 'Satın Alma Detayı'
                );

                $('#detailModalSubtitle').text(
                    rowData.workingname || 'Kayıt detayları'
                );

                var editUrl = '/satinalimiguncelle/' + rowData.id;

                $('#detailEditButton').attr('href', editUrl);

                $('#detailDeleteButton')
                    .attr('data-file-id', rowData.id)
                    .attr('data-file-name', rowData.workingname);

                $('#purchaseDetailModal').modal('show');
            }

            $('#myTable tbody').on('dblclick', 'tr', function (e) {
                if (
                    $(e.target).closest(
                        '.btn, .action-btn-group, a, button, input'
                    ).length
                ) {
                    return;
                }

                var tr = $(this);

                var rowData = {
                    id: tr.attr('data-id'),
                    fileno: tr.attr('data-fileno'),
                    workingname: tr.attr('data-workingname'),
                    firm: tr.attr('data-firm'),
                    price: tr.attr('data-price'),
                    purchasedate: tr.attr('data-purchasedate'),
                    purchaseform: tr.attr('data-purchaseform'),
                    purchasekind: tr.attr('data-purchasekind'),
                    purchasetype: tr.attr('data-purchasetype'),
                    description: tr.attr('data-description'),
                    filepath: tr.attr('data-filepath')
                };

                showPurchaseDetail(rowData);
            });

            $('#detailCopyPathBtn').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                var path = $(this).attr('data-path');

                if (!path || path === '-' || path.trim() === '') {
                    path = $('#detailFilePathText').text();
                }

                if (!path || path === '-' || path.trim() === '') {
                    showCopyNotification(false);
                    return;
                }

                var success = copyTextToClipboard(path);

                showCopyNotification(success);
            });

            $('#detailDeleteButton').on('click', function () {
                var id = $(this).attr('data-file-id');
                var name = $(this).attr('data-file-name');

                $('#purchaseDetailModal').modal('hide');

                setTimeout(function () {
                    $('#fileId').val(id);
                    $('#fileName').text(name);
                    $('#deleteModal').modal('show');
                }, 300);
            });
        });
    </script>
}
