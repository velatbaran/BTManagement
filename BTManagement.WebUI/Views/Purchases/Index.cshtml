                        <th><input type="text" class="filter-input" placeholder="Dosya No..." data-column="0" /></th>
                        <th><input type="text" class="filter-input" placeholder="İşin Adı..." data-column="1" /></th>
                        <th><input type="text" class="filter-input" placeholder="Firma..." data-column="2" /></th>
                        <th><input type="text" class="filter-input text-end" placeholder="Fiyat..." data-column="3" /></th>
                        <th><input type="text" class="filter-input" placeholder="Tarih..." data-column="4" /></th>
                        <th><input type="text" class="filter-input" placeholder="Şekil..." data-column="5" /></th>
                        <th><input type="text" class="filter-input" placeholder="Tür..." data-column="6" /></th>
                        <th><input type="text" class="filter-input" placeholder="Tip..." data-column="7" /></th>
                        <th><input type="text" class="filter-input" placeholder="Açıklama..." data-column="8" /></th>
                        <th><input type="text" class="filter-input" placeholder="Dosya Yolu..." data-column="9" /></th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-id="@item.Id"
                                data-fileno="@item.FileNo"
                                data-workingname="@item.WorkingName"
                                data-firm="@item.Firms?.Name"
                                data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-purchasedate="@item.PurchaseDate.ToString("dd.MM.yyyy")"
                                data-purchaseform="@item.PurchaseForms?.Name"
                                data-purchasekind="@item.PurchaseKinds?.Name"
                                data-purchasetype="@item.PurchaseTypes?.Name"
                                data-description="@item.Description"
                                data-filepath="@item.FilePath">

                                <td class="fw-medium text-dark">
                                    @Html.DisplayFor(m => item.FileNo)
                                </td>

                                <td>
                                    @Html.DisplayFor(m => item.WorkingName)
                                </td>

                                <td>
                                    @Html.DisplayFor(m => item.Firms.Name)
                                </td>

                                <td data-value="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    class="text-end fw-bold text-dark">
                                    @item.Price.ToString("N2", new System.Globalization.CultureInfo("tr-TR")) ₺
                                </td>

                                <td>
                                    @Html.DisplayFor(m => item.PurchaseDate)
                                </td>

                                <td>
                                    <span class="badge bg-light text-secondary border">
                                        @Html.DisplayFor(m => item.PurchaseForms.Name)
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-secondary border">
                                        @Html.DisplayFor(m => item.PurchaseKinds.Name)
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-secondary border">
                                        @Html.DisplayFor(m => item.PurchaseTypes.Name)
                                    </span>
                                </td>

                                <td class="text-truncate"
                                    style="max-width:150px;"
                                    title="@item.Description">
                                    @Html.DisplayFor(m => item.Description)
                                </td>

                                <td class="text-truncate"
                                    style="max-width:120px;"
                                    title="@item.FilePath">
                                    @Html.DisplayFor(m => item.FilePath)
                                </td>

                                <td class="text-center">
                                    <div class="action-btn-group">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-edit"
                                           title="Güncelle">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Güncelle
                                        </a>

                                        <button type="button"
                                                class="btn btn-delete"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-file-id="@item.Id"
                                                data-file-name="@item.WorkingName"
                                                title="Sil">
                                            <i class="fa-solid fa-trash-can"></i>
                                            Sil
                                        </button>

                                        <button type="button"
                                                class="btn btn-copy copy-path-btn"
                                                data-path="@item.FilePath"
                                                title="Dosya Yolunu Kopyala">
                                            <i class="fa-regular fa-copy"></i>
                                            Kopyala
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                </tbody>
            </table>
        </div>
    </div>
</div>
