@model IEnumerable<MyGuide>

@{
    ViewData["Title"] = "Rehber Listesi";
}

<!-- DataTables & FontAwesome CSS -->
<link href="~/datatable/buttons.datatables.css" rel="stylesheet" />
<link href="~/datatable/responsive.datatables.min.css" rel="stylesheet" />
<link href="~/datatable/datatables.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link href="~/css/guide-theme.css" rel="stylesheet" />
<div class="container-fluid px-0">
    <!-- Header Kartı -->
    <div class="card app-card mb-3">
        <div class="card-body app-card-header d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-3" style="background: #eef2ff; color: #4B49AC;">
                    <i class="fa-solid fa-address-book fa-lg"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: #0f172a;">Rehber Listesi</h5>
                    <p class="text-muted small mb-0">Kurum içi iletişim ve rehber kayıtlarını yönetin.</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-modern-primary d-inline-flex align-items-center gap-2" title="Yeni Ekle">
                <i class="fa-solid fa-plus"></i> Yeni Ekle
            </a>
        </div>
    </div>

    <!-- Tablo Kartı -->
    <div class="card app-card">
        <div class="table-responsive-wrapper">
            <table class="table table-hover align-middle" id="myTable">
                <thead>
                    <tr>
                        <th><i class="fa-solid fa-user me-1"></i> @Html.DisplayNameFor(m => m.NameSurname)</th>
                        <th><i class="fa-solid fa-id-card me-1"></i> @Html.DisplayNameFor(m => m.Title)</th>
                        <th><i class="fa-solid fa-building me-1"></i> @Html.DisplayNameFor(m => m.DepartmentId)</th>
                        <th class="text-start"><i class="fa-solid fa-phone me-1"></i> @Html.DisplayNameFor(m => m.InternalNo)</th>
                        <th><i class="fa-solid fa-mobile-screen-button me-1"></i> @Html.DisplayNameFor(m => m.CepNo)</th>
                        <th class="text-center" style="width: 160px;">İşlemler</th>
                    </tr>
                    <tr>
                        <th><input type="text" class="table-filter-input" placeholder="Ara Ad Soyad..." /></th>
                        <th><input type="text" class="table-filter-input" placeholder="Ara Unvan..." /></th>
                        <th><input type="text" class="table-filter-input" placeholder="Ara Şube..." /></th>
                        <th><input type="text" class="table-filter-input" placeholder="Ara Dahili No..." /></th>
                        <th><input type="text" class="table-filter-input" placeholder="Ara Cep No..." /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">
                                <i class="fa-solid fa-user-circle text-secondary me-2"></i>@Html.DisplayFor(m => item.NameSurname)
                            </td>
                            <td>
                                <i class="fa-solid fa-user-tie text-muted me-2"></i>@Html.DisplayFor(m => item.Title)
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-building me-1 text-muted"></i>@Html.DisplayFor(m => item.Department.Name)
                                </span>
                            </td>
                            <td class="text-start font-monospace">
                                <i class="fa-solid fa-phone-flip text-primary me-2 opacity-75"></i>@Html.DisplayFor(m => item.InternalNo)
                            </td>
                            <td class="font-monospace">
                                <i class="fa-solid fa-mobile-screen text-success me-2 opacity-75"></i>@Html.DisplayFor(m => item.CepNo)
                            </td>
                            <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a class="btn-action-edit" asp-action="Edit" asp-route-id="@item.Id" title="Güncelle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span>Düzenle</span>
                                    </a>
                                    <button type="button" class="btn-action-delete"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-file-id="@item.Id" data-file-name="@item.NameSurname" title="Sil">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span>Sil</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modern Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
            <form method="post" asp-action="Delete">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="deleteModalLabel">
                        <i class="fa-solid fa-triangle-exclamation"></i> Silme Onayı
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="mb-0 text-secondary">
                        <strong id="fileName" class="text-dark"></strong> kişisini rehberden silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
                    </p>
                    <input type="hidden" name="id" id="fileId" />
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-2 px-3 fw-medium" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i> İptal
                    </button>
                    <button type="submit" class="btn btn-danger rounded-2 px-3 fw-medium">
                        <i class="fa-solid fa-trash me-1"></i> Evet, Sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/datatable/datatables.min.js"></script>
    <script src="~/datatable/datatables.responsive.min.js"></script>
    <script src="~/datatable/datatables.buttons.min.js"></script>
    <script src="~/datatable/buttons.html5.min.js"></script>
    <script src="~/datatable/buttons.print.min.js"></script>
    <script src="~/datatable/jszip.min.js"></script>
    <script src="~/datatable/pdfmake.min.js"></script>
    <script src="~/datatable/vfs_fonts.js"></script>

    <script>
        $(document).ready(function () {

            var table = $('#myTable').DataTable({
                stateSave: true,
                dom: '<"d-flex align-items-center justify-content-between mb-3"B>rtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="fa-solid fa-file-excel text-success me-1"></i> Excel',
                        exportOptions: { columns: ':not(:last-child)' }
                    },
                    { extend: 'copy', text: '<i class="fa-solid fa-copy me-1"></i> Kopyala' },
                    { extend: 'csv', text: '<i class="fa-solid fa-file-csv me-1"></i> CSV' },
                    { extend: 'pdf', text: '<i class="fa-solid fa-file-pdf text-danger me-1"></i> PDF' },
                    { extend: 'print', text: '<i class="fa-solid fa-print me-1"></i> Yazdır' }
                ],
                responsive: { details: { type: 'column' } },
                columnDefs: [
                    { orderable: false, targets: -1 }
                ],
                order: [[0, 'asc']],
                language: { url: '/datatable/tr.json' }
            });

            function normalizeTr(text) {
                if (!text) return "";
                return text.toString()
                    .toLowerCase()
                    .replace(/ı/g, "i")
                    .replace(/İ/g, "i")
                    .replace(/i̇/g, "i")
                    .replace(/ğ/g, "g")
                    .replace(/ü/g, "u")
                    .replace(/ş/g, "s")
                    .replace(/ö/g, "o")
                    .replace(/ç/g, "c");
            }

            // Modal tetikleme
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                $('#fileId').val(button.data('file-id'));
                $('#fileName').text(button.data('file-name'));
            });

            let filters = ["", "", "", "", ""];

            // Filtre değişince kaydet
            $('#myTable thead tr:eq(1) th input').on('keyup', function () {
                $('#myTable thead tr:eq(1) th input').each(function (i) {
                    filters[i] = $(this).val();
                });

                localStorage.setItem("guideFilters", JSON.stringify(filters));
                table.draw(false);
            });

            $.fn.dataTable.ext.search.push(function(settings, data, dataIndex){
                if (settings.nTable.id !== 'myTable') return true;

                var nameSurnameInput = normalizeTr(filters[0]);
                var titleInput = normalizeTr(filters[1]);
                var departmentInput = normalizeTr(filters[2]);
                var internalNoInput = normalizeTr(filters[3]);
                var cepNoInput = normalizeTr(filters[4]);

                var rowNameSurname = normalizeTr(data[0]);
                var rowTitle = normalizeTr(data[1]);
                var rowDepartment = normalizeTr(data[2]);
                var rowInternalNo = normalizeTr(data[3]);
                var rowCepNo = normalizeTr(data[4]);

                if (nameSurnameInput && !rowNameSurname.includes(nameSurnameInput)) return false;
                if (titleInput && !rowTitle.includes(titleInput)) return false;
                if (departmentInput && !rowDepartment.includes(departmentInput)) return false;
                if (internalNoInput && !rowInternalNo.includes(internalNoInput)) return false;
                if (cepNoInput && !rowCepNo.includes(cepNoInput)) return false;

                return true;
            });

            $('#myTable thead input').on('click focus', function (e) {
                e.stopPropagation();
            });

            var savedFilters = JSON.parse(localStorage.getItem("guideFilters"));
            if (savedFilters) {
                filters = savedFilters;
                $('#myTable thead tr:eq(1) th input').each(function (i) {
                    $(this).val(filters[i]);
                });
            }
        });
    </script>
}