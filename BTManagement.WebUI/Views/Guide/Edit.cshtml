@model MyGuide

@{
    ViewData["Title"] = "Rehber Güncelle";
}

<link href="~/css/guide-theme.css" rel="stylesheet" />

<div class="container-fluid px-0">
    <!-- Sayfa Üst Başlığı -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="form-header-icon">
                <i class="fa-solid fa-user-pen"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">Rehber Kaydını Güncelle</h4>
                <p class="text-muted small mb-0">Mevcut rehber bilgilerini güncelleyebilirsiniz.</p>
            </div>
        </div>
        <a href="/rehberim" class="btn btn-outline-secondary btn-sm rounded-2 px-3 fw-medium">
            <i class="fa-solid fa-arrow-left me-1"></i> Listeye Dön
        </a>
    </div>

    <!-- Form Kartı -->
    <div class="row">
        <div class="col-lg-6">
            <div class="card form-card">
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <!-- Hidden Alanlar -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="Created" />

                        @await Html.PartialAsync("_GuideForm", Model)

                        <!-- Alt Butonlar -->
                        <div class="pt-3 mt-4 border-top d-flex align-items-center justify-content-end gap-2">
                            <a href="/rehberim" class="btn btn-light btn-sm fw-medium px-3 border">
                                <i class="fa-solid fa-ban me-1"></i> İptal
                            </a>
                            <button type="submit" class="btn btn-warning text-white btn-sm fw-medium px-4">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}