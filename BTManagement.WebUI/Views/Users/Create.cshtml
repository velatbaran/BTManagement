@model Users
@{
    ViewData["Title"] = "Kullanıcı Ekle";
}

<link href="~/css/user-theme.css" rel="stylesheet" />

<div class="row justify-content-start mb-5">
    <div class="col-lg-6">
        <div class="form-card">
            <div class="form-card-header">
                <h5>
                    <i class="fa-solid fa-user-plus"></i> Yeni Kullanıcı Ekle
                </h5>
            </div>

            <div class="form-card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="NameSurname" class="form-label">Ad Soyad</label>
                        <input asp-for="NameSurname" class="form-control" placeholder="Ad ve soyad giriniz..." />
                        <span asp-validation-for="NameSurname" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Username" class="form-label">Kullanıcı Adı</label>
                        <input asp-for="Username" class="form-control" placeholder="Kullanıcı adı belirleyiniz..." />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <input type="password" asp-for="Password" class="form-control" placeholder="Şifre belirleyiniz..." />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-2">
                        <button type="submit" class="btn-submit" title="Kaydet">
                            <i class="fa-solid fa-floppy-disk"></i> Kaydet
                        </button>
                        <a href="/kullanicilar" class="btn-cancel" title="İptal">
                            <i class="fa-solid fa-xmark"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>