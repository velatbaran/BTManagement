@model IEnumerable<Users>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
}

<style>
    /* Ana Kart Yapısı */
    .main-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .main-card-header {
        background-color: #4B49AC;
        color: #ffffff;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .main-card-header h5 {
            margin: 0;
            font-weight: 600;
            font-size: 1.1rem;
            letter-spacing: 0.02em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .main-card-body {
        padding: 24px;
    }

    /* Tablo Stilleri */
    .custom-table-container {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
        font-family: inherit;
        font-size: 13px;
        color: #334155;
        border-collapse: collapse !important;
    }

        /* Sadece ana başlık satırı mor */
        .table thead tr:first-child th {
            background-color: #4B49AC;
            color: #ffffff;
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 12px;
            border-bottom: 2px solid #3f3da0;
        }

        /* Filtreleme inputlarının yer aldığı 2. satır beyaz */
        .table thead tr:nth-child(2) th {
            background-color: #ffffff;
            padding: 8px 12px;
            border-bottom: 2px solid #e2e8f0;
        }

        .table td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .table tbody tr:hover {
            background-color: #f8fafc;
        }

    /* Filtre Input Stilleri */
    .filter-input {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 12px;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .filter-input:focus {
            outline: none;
            border-color: #4B49AC;
            box-shadow: 0 0 0 3px rgba(75, 73, 172, 0.15);
        }

    /* Buton Tasarımları */
    .btn-theme-primary {
        background-color: #4B49AC;
        color: #ffffff;
        border: 1px solid #4B49AC;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 500;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-theme-primary:hover {
            background-color: #3f3da0;
            color: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(75, 73, 172, 0.25);
        }

    .btn-action-edit {
        background-color: #fefce8;
        color: #ca8a04;
        border: 1px solid #fef08a;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-action-edit:hover {
            background-color: #ca8a04;
            color: #ffffff;
            border-color: #ca8a04;
        }

    .btn-action-delete {
        background-color: #fef2f2;
        color: #ef4444;
        border: 1px solid #fee2e2;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-action-delete:hover {
            background-color: #ef4444;
            color: #ffffff;
            border-color: #ef4444;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="m-0 font-weight-bold text-dark"></h4>
    <a asp-action="Create" class="btn-theme-primary" title="Yeni Ekle">
        <i class="fa-solid fa-user-plus"></i> Yeni Kullanıcı Ekle
    </a>
</div>

<div class="main-card mb-4">
    <div class="main-card-header">
        <h5>
            <i class="fa-solid fa-users"></i> Kullanıcı Listesi
        </h5>
    </div>
    <div class="main-card-body">
        <div class="custom-table-container">
            <table class="table table-hover align-middle mb-0" id="myTable">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.NameSurname)</th>
                        <th>@Html.DisplayNameFor(m => m.Username)</th>
                        <th>@Html.DisplayNameFor(m => m.IsAdmin)</th>
                        <th>@Html.DisplayNameFor(m => m.IsActive)</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                    <tr>
                        <th><input type="text" class="filter-input" placeholder="Ara Ad Soyad..." /></th>
                        <th><input type="text" class="filter-input" placeholder="Ara Kullanıcı Adı..." /></th>
                        <th><input type="text" class="filter-input" placeholder="Ara Admin..." /></th>
                        <th><input type="text" class="filter-input" placeholder="Ara Aktif..." /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">@Html.DisplayFor(m => item.NameSurname)</td>
                            <td>@Html.DisplayFor(m => item.Username)</td>

                            <!-- Admin Kolonu -->
                            <td>
                                @if (item.IsAdmin)
                                {
                                    <span class="badge bg-danger-subtle text-success px-2 py-1 rounded-pill fw-semibold">
                                        <i class="fa-solid fa-user-shield me-1"></i> Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-danger px-2 py-1 rounded-pill fw-normal">
                                        <i class="fa-regular fa-user me-1"></i> Standart
                                    </span>
                                }
                            </td>

                            <!-- Aktif Kolonu -->
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill fw-semibold">
                                        <i class="fa-solid fa-circle-check me-1"></i> Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted px-2 py-1 rounded-pill fw-normal">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Pasif
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <a class="btn-action-edit me-1" asp-action="Edit" asp-route-id="@item.Id" title="Güncelle">
                                    <i class="fa-solid fa-pen-to-square"></i> Güncelle
                                </a>
                                <button type="button" class="btn-action-delete"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-file-id="@item.Id" data-file-name="@item.NameSurname" title="Sil">
                                    <i class="fa-solid fa-trash"></i> Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modern Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
            <form method="post" asp-action="Delete">
                <div class="modal-header text-white" style="background-color: #ef4444;">
                    <h5 class="modal-title fs-6" id="deleteModalLabel">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Silme Onayı
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-0 text-secondary">
                        <strong id="fileName" class="text-dark"></strong> adlı kullanıcıyı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
                    </p>
                    <input type="hidden" name="id" id="fileId" />
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-sm btn-light border px-3" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="fa-solid fa-trash me-1"></i> Evet, Sil
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="~/datatable/responsive.datatables.min.css" rel="stylesheet" />
    <link href="~/datatable/datatables.min.css" rel="stylesheet" />
    <script src="~/datatable/datatables.min.js"></script>
    <script src="~/datatable/datatables.responsive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                $('#fileId').val(button.data('file-id'));
                $('#fileName').text(button.data('file-name'));
            });

            var table = $('#myTable').DataTable({
                dom: 'Brtip',
                language: { url: '/datatable/tr.json' }
            });

            $('#myTable thead tr:eq(1) th').each(function (i) {
                $('input', this).on('keyup change clear', function () {
                    if (table.column(i).search() !== this.value) {
                        table.column(i).search(this.value).draw();
                    }
                });
            });
        });
    </script>
}