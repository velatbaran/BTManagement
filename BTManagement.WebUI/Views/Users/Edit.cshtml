@model UserEditViewModel
@{
    ViewData["Title"] = "Kullanıcı Güncelle";
}

<link href="~/css/user-theme.css" rel="stylesheet" />

<div class="row justify-content-start mb-5">
    <div class="col-lg-8">
        <div class="form-card">
            <div class="form-card-header">
                <h5>
                    <i class="fa-solid fa-user-pen"></i> Kullanıcı Bilgilerini Güncelle
                </h5>
            </div>

            <div class="form-card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="NameSurname" class="form-label">Ad Soyad</label>
                        <input asp-for="NameSurname" class="form-control" placeholder="Ad ve soyad giriniz..." />
                        <span asp-validation-for="NameSurname" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Username" class="form-label">Kullanıcı Adı</label>
                        <input asp-for="Username" class="form-control" placeholder="Kullanıcı adı giriniz..." />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <input asp-for="Password" type="text" class="form-control" placeholder="Şifrenizi güncelleyin..." />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-2 mb-md-0">
                            <div class="custom-switch-box">
                                <input class="form-check-input mt-0" asp-for="IsAdmin" id="IsAdmin" />
                                <label class="form-check-label fw-semibold text-secondary" for="IsAdmin">
                                    @Html.DisplayNameFor(model => model.IsAdmin)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="custom-switch-box">
                                <input class="form-check-input mt-0 " asp-for="IsActive" id="IsActive" />
                                <label class="form-check-label fw-semibold text-secondary" for="IsActive">
                                    @Html.DisplayNameFor(model => model.IsActive)
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-2">
                        <button type="submit" class="btn-submit" title="Güncelle">
                            <i class="fa-solid fa-floppy-disk"></i> Güncelle
                        </button>
                        <a href="/kullanicilar" class="btn-cancel" title="İptal">
                            <i class="fa-solid fa-xmark"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>