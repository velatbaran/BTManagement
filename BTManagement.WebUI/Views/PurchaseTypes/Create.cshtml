@model PurchaseType

@{
    ViewData["Title"] = "Satın Alma Tipi Ekle";
}

<link href="~/css/custom-theme.css" rel="stylesheet" />

<div class="row justify-content-start mb-5">
    <div class="col-lg-8">
        <div class="form-card">
            <div class="form-card-header">
                <h5>
                    <i class="fa-solid fa-layer-group"></i> Yeni Satın Alma Tipi Ekle
                </h5>
            </div>

            <div class="form-card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Satın Alma Tipi Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: Doğrudan Temin, Açık İhale vb." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-2">
                        <button type="submit" class="btn-submit" title="Kaydet">
                            <i class="fa-solid fa-floppy-disk"></i> Kaydet
                        </button>
                        <a href="/satinalimtipleri" class="btn-cancel" title="İptal">
                            <i class="fa-solid fa-xmark"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}