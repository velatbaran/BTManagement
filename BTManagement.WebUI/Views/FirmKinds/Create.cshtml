@model FirmKind

@{
    ViewData["Title"] = "Firma Türü Ekle";
}

<link href="~/css/custom-theme.css" rel="stylesheet" />

<div class="row justify-content-start mb-5">
    <div class="col-md-8 col-lg-6">
        <div class="form-card">
            <div class="form-card-header">
                <h5>
                    <i class="fa-solid fa-folder-plus"></i> Firma Türü Ekle
                </h5>
            </div>
            <div class="form-card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Firma Türü Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Firma türü giriniz..." />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-submit" title="Kaydet">
                            <i class="fa-solid fa-floppy-disk"></i> Ekle
                        </button>
                        <a asp-action="Index" class="btn-cancel" title="İptal">
                            <i class="fa-solid fa-ban"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}