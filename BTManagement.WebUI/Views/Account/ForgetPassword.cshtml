@model ForgetPasswordViewModel

@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Şifremi Unuttum";
}
<link href="~/css/login.css" rel="stylesheet" />
<div class="login-page">

    <div class="login-wrapper">

        <!-- =================================================
             SOL KURUMSAL ALAN
             ================================================= -->

        <div class="login-brand-panel">

            <div class="brand-content">

                <div class="brand-logo">

                    <img src="~/template/images/dsi24.png"
                         alt="DSİ 24. Bölge Müdürlüğü" />

                </div>

                <span class="brand-small-title">
                    DSİ 24. Bölge Müdürlüğü
                </span>

                <h1>
                    BT Yönetimi
                </h1>

                <h2>
                    Güvenli Hesap<br />
                    Yönetimi
                </h2>

                <p class="brand-description">
                    Kullanıcı hesabınızın güvenliğini
                    korumak için şifre yenileme işlemini
                    kolayca gerçekleştirebilirsiniz.
                </p>


                <div class="brand-features">

                    <div class="brand-feature">

                        <span class="brand-feature-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>

                        <span>
                            Tüm BT süreçlerinizi tek merkezden yönetin.
                        </span>

                    </div>


                    <div class="brand-feature">

                        <span class="brand-feature-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </span>

                        <span>
                            Güvenli ve yetkilendirilmiş erişim sağlayın.
                        </span>

                    </div>


                    <div class="brand-feature">

                        <span class="brand-feature-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </span>

                        <span>
                            İş süreçlerinizi hızlı ve verimli şekilde takip edin.
                        </span>

                    </div>

                </div>

            </div>


            <div class="brand-footer">

                <strong>
                    Devlet Su İşleri Genel Müdürlüğü
                </strong>

                <br />

                24. Bölge Müdürlüğü · Bilgi Teknolojileri Şube Müdürlüğü

            </div>

        </div>


        <!-- =================================================
             SAĞ FORM
             ================================================= -->

        <div class="login-form-panel">

            <div class="login-form-container">


                <div class="form-logo">

                    <img src="~/template/images/dsi24.png"
                         alt="DSİ Logo" />

                </div>


                <div class="form-header">

                    <h2>
                        Şifrenizi Yenileyin
                    </h2>

                    <p>
                        Yeni şifrenizi oluşturmak için
                        bilgilerinizi giriniz.
                    </p>

                </div>


                <div class="form-info">

                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Lütfen sistemde kayıtlı olan
                        kullanıcı adınızı giriniz.
                    </span>

                </div>


                <form class="login-form"
                      method="post"
                      asp-action="ForgetPassword"
                      asp-controller="Account"
                      id="forgetPasswordForm">


                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>


                    <!-- Kullanıcı Adı -->

                    <div class="form-group">

                        <label asp-for="Username">
                            Kullanıcı Adı
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-user input-icon"></i>

                            <input asp-for="Username"
                                   class="login-input"
                                   placeholder="Kullanıcı adınızı giriniz..."
                                   autocomplete="username" />

                        </div>

                        <span asp-validation-for="Username"
                              class="login-validation">
                        </span>

                    </div>


                    <!-- Yeni Şifre -->

                    <div class="form-group">

                        <label asp-for="Password">
                            Yeni Şifre
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-lock input-icon"></i>

                            <input type="password"
                                   asp-for="Password"
                                   class="login-input password-input"
                                   placeholder="Yeni şifrenizi giriniz..."
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    title="Şifreyi göster">

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="login-validation">
                        </span>

                    </div>


                    <!-- Şifre Tekrar -->

                    <div class="form-group">

                        <label asp-for="RePassword">
                            Yeni Şifre Tekrar
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-shield-halved input-icon"></i>

                            <input type="password"
                                   asp-for="Password"
                                   class="login-input password-input"
                                   placeholder="Yeni şifrenizi giriniz..."
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    title="Şifreyi göster">

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="RePassword"
                              class="login-validation">
                        </span>

                    </div>


                    <!-- Butonlar -->

                    <div class="password-actions">

                        <button type="submit"
                                class="change-password-button"
                                id="changePasswordButton">

                            <i class="fa-solid fa-key"></i>

                            <span>
                                Yeni Şifre Al
                            </span>

                        </button>


                        <a href="/login"
                           class="login-secondary-button">

                            <i class="fa-solid fa-arrow-left"></i>

                            <span>
                                Giriş Sayfası
                            </span>

                        </a>

                    </div>

                </form>


                <div class="form-footer">

                    <strong>
                        DSİ 24. Bölge Müdürlüğü
                    </strong>

                    <br />

                    Bilgi Teknolojileri Yönetim Sistemi

                </div>

            </div>

        </div>

    </div>

</div>
<script src="~/js/login.js"></script>